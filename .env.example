# Copy thành .env (đã .gitignore) để chạy docker compose; trên Render khai báo các biến này trong Environment.
# "__" tương đương dấu ":" trong cấu hình .NET (Jwt__SecretKey = Jwt:SecretKey), "__0" là phần tử đầu của mảng.

# Supabase: dùng Session pooler (aws-0-<region>.pooler.supabase.com:5432) — Render không kết nối được db.<ref>.supabase.co (chỉ IPv6)
ConnectionStrings__DefaultConnection=''

# SePay: API key trùng với key khai báo ở SePay → Webhooks (kiểu chứng thực "API Key"); webhook URL = <api>/api/v1/payments/webhooks/sepay
# BankName theo mã của qr.sepay.vn (MBBank, Vietcombank, ...); tài khoản là tài khoản đã liên kết với SePay
SePay__Api__Key=
SePay__BankName=
SePay__AccountNumber=
SePay__AccountName=

Refund__PayoutRetentionDays=30
# Khóa AES-256 mã hóa tài khoản nhận hoàn: Base64 của 32 byte (openssl rand -base64 32). Đổi khóa làm payload cũ không giải mã được.
RefundDataEncryptionKey=

# Gmail SMTP gửi lời mời participant: Username là địa chỉ Gmail, Password là App Password 16 ký tự
# (myaccount.google.com/apppasswords, cần bật xác minh 2 bước). FrontendBaseUrl dùng tạo link trong email.
Email__Username=
Email__FromAddress=
Email__FrontendBaseUrl=http://localhost:5173
Email__Password=

# Khóa ký link mời nhóm, tối thiểu 32 ký tự, không dùng chung với Jwt. Đổi khóa làm mọi link đang có hết hiệu lực.
Invite__SigningKey=

# Tối thiểu 32 ký tự, app không khởi động được nếu thiếu
Jwt__SecretKey=
Jwt__Issuer=RenTrek.API
Jwt__Audience=RenTrek.Client
Jwt__AccessTokenExpirationMinutes=30
Jwt__RefreshTokenExpirationDays=7

AutoMapper__LicenseKey=

# Google OAuth 2.0 (ClientId dùng kiểm tra chữ ký aud của Google ID Token)
GoogleAuth__ClientId=

# Domain FE được gọi API (thêm Cors__AllowedOrigins__1, __2... nếu nhiều domain)
Cors__AllowedOrigins__0=http://localhost:5173

# Supabase Storage lưu ảnh (avatar, ảnh bài viết). Dashboard → Storage: tạo bucket "uploads", bật Public.
# ServiceKey = service_role key (Project Settings → API), CHỈ để ở BE. Bỏ trống thì ảnh lưu wwwroot/uploads (chỉ dùng dev).
Supabase__Url=
Supabase__ServiceKey=
Supabase__Bucket=uploads

# Bật Swagger UI tại /swagger ở môi trường không phải Development (vd Render). Xóa biến này để tắt.
Swagger__Enabled=true
